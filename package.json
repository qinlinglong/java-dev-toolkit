{
    "name": "advanced-copy-for-java",
    "displayName": "Advanced Copy for Java",
    "description": "Advanced copy functionality for Java projects with REST navigation",
    "version": "0.1.7",
    "engines": {
        "vscode": "^1.60.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onLanguage:java",
        "onCommand:advanced-copy-java.copyQualifiedName",
        "onCommand:advanced-copy-java.copyRelativePath",
        "onCommand:advanced-copy-java.copyWithPackage",
        "onCommand:advanced-copy-java.restNavigate"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "advanced-copy-java.copyQualifiedName",
                "title": "Copy Java Class Qualified Name"
            },
            {
                "command": "advanced-copy-java.copyRelativePath",
                "title": "Copy Relative Path"
            },
            {
                "command": "advanced-copy-java.copyWithPackage",
                "title": "Copy Full Content with Package Info"
            },
            {
                "command": "advanced-copy-java.restNavigate",
                "title": "REST Navigation to Java Class (Fuzzy Matching)"
            }
        ],
        "menus": {
            "editor/context": [
                {
                    "command": "advanced-copy-java.copyQualifiedName",
                    "group": "copy"
                },
                {
                    "command": "advanced-copy-java.copyRelativePath",
                    "group": "copy"
                },
                {
                    "command": "advanced-copy-java.copyWithPackage",
                    "group": "copy"
                },
                {
                    "command": "advanced-copy-java.restNavigate",
                    "group": "navigation"
                }
            ]
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile && npm run lint",
        "lint": "eslint src --ext ts",
        "test": "node ./out/test/runTest.js"
    },
    "devDependencies": {
        "@types/node": "14.x",
        "@types/vscode": "^1.60.0",
        "@typescript-eslint/eslint-plugin": "^5.38.0",
        "@typescript-eslint/parser": "^5.38.0",
        "@vscode/vsce": "^3.7.1",
        "eslint": "^8.24.0",
        "typescript": "^4.8.4"
    }
}
